rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["coach", "player"];
      allow read: if signedIn()
        && (request.auth.uid == userId || isCoach());
      allow update: if isCoach() || (signedIn() && request.auth.uid == userId);
      allow delete: if isCoach();
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /dayMeta/{dayId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /duties/{dutyId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /quotes/{quoteId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /notes/{noteId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /players/{playerId} {
      allow read: if isCoach()
        || (signedIn()
          && (
            (resource.data.keys().hasAny(["uid"])
              && resource.data.uid == request.auth.uid)
            || resource.data.email == request.auth.token.email
          ));
      allow create: if isCoach();
      allow update: if isCoach()
        || (
          signedIn()
          && resource.data.email == request.auth.token.email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.inviteStatus == "active"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "uid", "inviteStatus", "name", "dob", "heightCm", "weightKg", "photoUrl"
          ])
          && (
            !resource.data.keys().hasAny(["uid"])
            || resource.data.uid == request.auth.uid
          )
        );
      allow delete: if isCoach();
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }
  }
}